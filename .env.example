# Override backend start command if needed
# Example (for Streamlit app): BACKEND_CMD=streamlit run src/app.py --server.address=0.0.0.0 --server.port=8501
BACKEND_CMD=uvicorn src.api:app --host 0.0.0.0 --port 8501

# Comma-separated frontend origins allowed by FastAPI CORS.
# Example: CORS_ORIGINS=https://thesis-prototype-frontend.onrender.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
